{
  "name": "footballcharts-mcp",
  "version": "0.2.0",
  "description": "MCP server for football-charts.com \u2014 tables, results, fixtures, model probabilities and Monte Carlo season projections for 90+ football leagues.",
  "type": "module",
  "bin": {
    "footballcharts-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http.js",
    "test:http": "node test/e2e-http.mjs"
  },
  "keywords": [
    "mcp",
    "football",
    "soccer",
    "statistics",
    "predictions",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "author": "Damir Devetak (https://www.football-charts.com)",
  "homepage": "https://www.football-charts.com/developers",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "mcpName": "io.github.ddevetak/footballcharts-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddevetak/footballcharts-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ddevetak/footballcharts-mcp/issues"
  }
}
